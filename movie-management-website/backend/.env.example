# Rename this file to .env before running the server

PORT=5000

# Secret used to sign login tokens - change this to something random
JWT_SECRET=replace_this_with_a_long_random_string

# OMDb is used by the admin dashboard to fill in movie information and posters.
OMDB_API_KEY=your_omdb_api_key

# Example: mongodb+srv://user:password@cluster.mongodb.net/cinenest?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# ---------------------------------------------------------
# DATABASE (not connected yet!)
# Right now this project just saves everything to a file
# called data/db.json so you don't need to set up a database
# to try it out.
#
# When you're ready to plug in a real database, this is where
# you'd add the connection string, e.g:
#
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/movieDB
# or
# DATABASE_URL=postgres://user:pass@localhost:5432/moviedb
# ---------------------------------------------------------
